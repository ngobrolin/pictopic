---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Ngobrolin Web - Topic Picker">
  <!-- Header -->
  <header class="py-20 md:py-32 border-b-2 border-border overflow-hidden">
    <div class="max-w-[95vw] mx-auto px-4 md:px-8">
      <h1
        class="text-[clamp(3rem,12vw,14rem)] font-bold uppercase leading-none tracking-tighter"
      >
        Ngobrolin
      </h1>
      <p
        class="text-lg md:text-xl lg:text-2xl text-muted-fg mt-4 tracking-tight leading-tight max-w-2xl"
      >
        Pick the next topic for our podcast discussion
      </p>
    </div>
  </header>

  <!-- Stats Marquee -->
  <section
    class="bg-accent text-accent-fg border-b-2 border-accent-fg/20 py-6 overflow-hidden"
  >
    <div class="marquee-track" style="--marquee-duration: 16s;">
      <div class="flex items-center gap-12 md:gap-20 px-8 shrink-0">
        <div class="flex items-center gap-3 md:gap-4">
          <span
            id="stat-topics-m1"
            class="text-[4rem] md:text-[6rem] font-bold leading-none"
            >--</span
          >
          <span class="text-sm md:text-lg font-bold uppercase tracking-widest"
            >Topics</span
          >
        </div>
        <span class="text-3xl md:text-5xl font-light opacity-30" aria-hidden="true">✦</span>
        <div class="flex items-center gap-3 md:gap-4">
          <span
            id="stat-votes-m1"
            class="text-[4rem] md:text-[6rem] font-bold leading-none"
            >--</span
          >
          <span class="text-sm md:text-lg font-bold uppercase tracking-widest"
            >Votes</span
          >
        </div>
        <span class="text-3xl md:text-5xl font-light opacity-30" aria-hidden="true">✦</span>
        <div class="flex items-center gap-3 md:gap-4">
          <span
            id="stat-comments-m1"
            class="text-[4rem] md:text-[6rem] font-bold leading-none"
            >--</span
          >
          <span class="text-sm md:text-lg font-bold uppercase tracking-widest"
            >Comments</span
          >
        </div>
        <span class="text-3xl md:text-5xl font-light opacity-30" aria-hidden="true">✦</span>
        <div class="flex items-center gap-3 md:gap-4">
          <span
            id="stat-contributors-m1"
            class="text-[4rem] md:text-[6rem] font-bold leading-none"
            >--</span
          >
          <span class="text-sm md:text-lg font-bold uppercase tracking-widest"
            >Contributors</span
          >
        </div>
        <span class="text-3xl md:text-5xl font-light opacity-30" aria-hidden="true">✦</span>
      </div>
      <!-- Duplicate for seamless loop -->
      <div class="flex items-center gap-12 md:gap-20 px-8 shrink-0" aria-hidden="true">
        <div class="flex items-center gap-3 md:gap-4">
          <span
            id="stat-topics-m2"
            class="text-[4rem] md:text-[6rem] font-bold leading-none"
            >--</span
          >
          <span class="text-sm md:text-lg font-bold uppercase tracking-widest"
            >Topics</span
          >
        </div>
        <span class="text-3xl md:text-5xl font-light opacity-30">✦</span>
        <div class="flex items-center gap-3 md:gap-4">
          <span
            id="stat-votes-m2"
            class="text-[4rem] md:text-[6rem] font-bold leading-none"
            >--</span
          >
          <span class="text-sm md:text-lg font-bold uppercase tracking-widest"
            >Votes</span
          >
        </div>
        <span class="text-3xl md:text-5xl font-light opacity-30">✦</span>
        <div class="flex items-center gap-3 md:gap-4">
          <span
            id="stat-comments-m2"
            class="text-[4rem] md:text-[6rem] font-bold leading-none"
            >--</span
          >
          <span class="text-sm md:text-lg font-bold uppercase tracking-widest"
            >Comments</span
          >
        </div>
        <span class="text-3xl md:text-5xl font-light opacity-30">✦</span>
        <div class="flex items-center gap-3 md:gap-4">
          <span
            id="stat-contributors-m2"
            class="text-[4rem] md:text-[6rem] font-bold leading-none"
            >--</span
          >
          <span class="text-sm md:text-lg font-bold uppercase tracking-widest"
            >Contributors</span
          >
        </div>
        <span class="text-3xl md:text-5xl font-light opacity-30">✦</span>
      </div>
    </div>
  </section>

  <main class="max-w-[95vw] mx-auto px-4 md:px-8">
    <!-- Picker Section -->
    <section class="py-20 md:py-32 border-b-2 border-border">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-start">
        <!-- Left: Title + Buttons -->
        <div>
          <h2
            class="text-5xl md:text-7xl lg:text-8xl font-bold uppercase leading-[0.85] tracking-tighter mb-8"
          >
            Random<br />Picker
          </h2>
          <p
            class="text-lg md:text-xl text-muted-fg tracking-tight leading-tight mb-10 max-w-md"
          >
            Click to randomly select the next discussion topic — or spin the
            wheel for extra drama
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <button
              id="pick-btn"
              disabled
              class="h-14 px-8 bg-accent text-accent-fg font-bold uppercase tracking-tighter text-lg transition-all hover:scale-105 active:scale-95 disabled:opacity-50 disabled:pointer-events-none"
            >
              Pick Random Topic
            </button>
            <button
              id="spin-btn"
              disabled
              class="h-14 px-8 border-2 border-border text-fg font-bold uppercase tracking-tighter text-lg transition-all hover:bg-fg hover:text-bg active:scale-95 disabled:opacity-50 disabled:pointer-events-none"
            >
              Spin the Wheel
            </button>
          </div>
        </div>

        <!-- Right: Selected Topic Display -->
        <div
          id="selected-topic"
          class="min-h-48 flex items-center justify-center border-2 border-border p-8 md:p-12"
        >
          <p class="text-muted-fg text-lg md:text-xl uppercase tracking-wider font-medium">
            No topic selected yet
          </p>
        </div>
      </div>
    </section>

    <!-- Sort Controls -->
    <section class="py-8 border-b-2 border-border">
      <div class="flex flex-wrap gap-3 items-center">
        <span
          class="text-xs md:text-sm text-muted-fg uppercase tracking-widest font-bold mr-2"
          >Sort:</span
        >
        <button
          data-sort="votes"
          class="sort-btn h-10 px-5 border-2 border-accent bg-accent text-accent-fg font-bold uppercase tracking-tighter text-sm transition-all"
        >
          Most Votes
        </button>
        <button
          data-sort="comments"
          class="sort-btn h-10 px-5 border-2 border-border text-fg font-bold uppercase tracking-tighter text-sm transition-all hover:bg-fg hover:text-bg"
        >
          Most Comments
        </button>
        <button
          data-sort="newest"
          class="sort-btn h-10 px-5 border-2 border-border text-fg font-bold uppercase tracking-tighter text-sm transition-all hover:bg-fg hover:text-bg"
        >
          Newest
        </button>
        <button
          data-sort="oldest"
          class="sort-btn h-10 px-5 border-2 border-border text-fg font-bold uppercase tracking-tighter text-sm transition-all hover:bg-fg hover:text-bg"
        >
          Oldest
        </button>
        <button
          id="reset-history-btn"
          class="ml-auto h-10 px-5 border-2 border-border text-muted-fg font-bold uppercase tracking-tighter text-sm transition-all hover:border-accent hover:text-accent hidden"
        >
          Reset History
        </button>
      </div>
    </section>

    <!-- Topics Grid -->
    <section class="py-12 md:py-20">
      <h2
        class="text-3xl md:text-5xl font-bold uppercase tracking-tighter mb-8 md:mb-12"
      >
        All Topics
      </h2>
      <div
        id="topics-grid"
        class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-border"
      >
        <!-- Topics rendered by JavaScript -->
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-accent text-accent-fg border-t-2 border-accent-fg/20">
    <div class="max-w-[95vw] mx-auto px-4 md:px-8 py-16 md:py-24">
      <p
        class="text-[clamp(1.5rem,5vw,4rem)] font-bold uppercase leading-none tracking-tighter"
      >
        Topics sourced from
        <a
          href="https://github.com/orgs/ngobrolin/discussions"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4 decoration-2 hover:opacity-70 transition-opacity"
        >
          GitHub Discussions
        </a>
      </p>
    </div>
  </footer>

  <!-- Wheel Modal -->
  <div
    id="wheel-modal"
    class="fixed inset-0 bg-bg/90 hidden items-center justify-center z-40"
  >
    <div class="bg-bg border-2 border-border p-8 md:p-12 max-w-3xl w-full mx-4">
      <div class="flex justify-between items-center mb-8">
        <h3 class="text-2xl md:text-3xl font-bold uppercase tracking-tighter">
          Spin the Wheel
        </h3>
        <button
          id="close-modal"
          class="w-10 h-10 flex items-center justify-center border-2 border-border text-muted-fg hover:bg-fg hover:text-bg transition-all"
          aria-label="Close modal"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="relative">
        <canvas
          id="wheel-canvas"
          width="600"
          height="600"
          class="mx-auto w-full max-w-[600px]"></canvas>
        <div
          class="absolute top-1/2 right-0 transform translate-x-2 -translate-y-1/2"
        >
          <div class="w-0 h-0 border-t-8 border-b-8 border-r-12 border-t-transparent border-b-transparent border-r-accent"></div>
        </div>
      </div>
      <div class="text-center mt-8">
        <button
          id="spin-wheel-btn"
          class="h-14 px-10 bg-accent text-accent-fg font-bold uppercase tracking-tighter text-lg transition-all hover:scale-105 active:scale-95"
        >
          Spin!
        </button>
      </div>
      <div id="wheel-result" class="mt-6 text-center hidden">
        <p class="text-xl md:text-2xl font-bold text-accent uppercase tracking-tighter"></p>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { topics as staticTopics } from "../data/topics";
  import type { Topic } from "../types/topic";
  import * as topicHistory from "../lib/topicHistory";

  function init() {
    let topics: Topic[] = [];
    let currentSort = "votes";
    let selectedTopicId: number | null = null;

    const pickBtn = document.getElementById("pick-btn") as HTMLButtonElement;
    const spinBtn = document.getElementById("spin-btn") as HTMLButtonElement;
    const selectedTopicDiv = document.getElementById("selected-topic")!;
    const topicsGrid = document.getElementById("topics-grid")!;
    const sortBtns = document.querySelectorAll(".sort-btn");
    const resetHistoryBtn = document.getElementById("reset-history-btn")!;
    const wheelModal = document.getElementById("wheel-modal")!;
    const closeModalBtn = document.getElementById("close-modal")!;
    const spinWheelBtn = document.getElementById("spin-wheel-btn")!;
    const wheelCanvas = document.getElementById(
      "wheel-canvas"
    ) as HTMLCanvasElement;
    const wheelResult = document.getElementById("wheel-result")!;

    function updateStats() {
      const totalTopics = topics.length.toString();
      const totalVotes = topics
        .reduce((sum, t) => sum + t.votes, 0)
        .toString();
      const totalComments = topics
        .reduce((sum, t) => sum + t.comments, 0)
        .toString();
      const totalContributors = new Set(
        topics.map((t) => t.author)
      ).size.toString();

      // Update both marquee copies
      const ids = [
        ["stat-topics-m1", "stat-topics-m2"],
        ["stat-votes-m1", "stat-votes-m2"],
        ["stat-comments-m1", "stat-comments-m2"],
        ["stat-contributors-m1", "stat-contributors-m2"],
      ];
      const values = [totalTopics, totalVotes, totalComments, totalContributors];

      ids.forEach((pair, i) => {
        pair.forEach((id) => {
          const el = document.getElementById(id);
          if (el) el.textContent = values[i];
        });
      });
    }

    function renderTopicCard(topic: Topic, isPicked = false) {
      const isSelected = selectedTopicId === topic.id;
      const pickedBadge = isPicked
        ? '<span class="absolute top-3 right-3 px-2 py-1 border border-border text-muted-fg text-xs font-bold uppercase tracking-widest">Picked</span>'
        : "";

      let stateClasses = "";
      let titleColor = "text-fg";
      let metaColor = "text-muted-fg";
      let linkColor = "text-accent hover:opacity-70";

      if (isPicked) {
        stateClasses = "opacity-40";
        titleColor = "text-muted-fg";
      } else if (isSelected) {
        stateClasses = "!bg-accent";
        titleColor = "text-accent-fg";
        metaColor = "text-accent-fg/70";
        linkColor = "text-accent-fg underline hover:opacity-70";
      }

      return (
        '<div class="topic-card group relative bg-bg p-6 md:p-8 cursor-pointer transition-all duration-300 hover:bg-accent ' +
        stateClasses +
        '" data-topic-id="' +
        topic.id +
        '">' +
        '<div class="relative">' +
        '<h3 class="font-bold text-lg md:text-xl uppercase tracking-tight mb-3 transition-colors duration-300 group-hover:text-accent-fg ' +
        titleColor +
        '">' +
        topic.title +
        "</h3>" +
        pickedBadge +
        "</div>" +
        '<div class="flex items-center gap-4 text-xs md:text-sm uppercase tracking-widest font-medium transition-colors duration-300 group-hover:text-accent-fg/70 ' +
        metaColor +
        '">' +
        "<span>" +
        topic.author +
        "</span>" +
        '<span class="flex items-center gap-1">' +
        "↑ " +
        topic.votes +
        "</span>" +
        '<span class="flex items-center gap-1">' +
        "◦ " +
        topic.comments +
        "</span>" +
        "</div>" +
        '<a href="' +
        topic.url +
        '" target="_blank" rel="noopener noreferrer" class="inline-block mt-4 text-sm font-bold uppercase tracking-tighter transition-colors duration-300 group-hover:text-accent-fg ' +
        linkColor +
        '" onclick="event.stopPropagation()">View Discussion →</a>' +
        "</div>"
      );
    }

    function sortTopics(sortBy: string) {
      const sortedTopics = [...topics].sort((a, b) => {
        switch (sortBy) {
          case "votes":
            return b.votes - a.votes;
          case "comments":
            return b.comments - a.comments;
          case "newest":
            return b.id - a.id;
          case "oldest":
            return a.id - b.id;
          default:
            return 0;
        }
      });

      topicsGrid.innerHTML = sortedTopics
        .map((topic) =>
          renderTopicCard(topic, topicHistory.isTopicPicked(topic.id))
        )
        .join("");
    }

    function displaySelectedTopic(topic: Topic) {
      selectedTopicDiv.innerHTML =
        '<div class="w-full">' +
        '<div class="flex items-center gap-2 mb-4">' +
        '<span class="text-accent font-bold text-xs md:text-sm uppercase tracking-widest">★ Selected Topic</span>' +
        "</div>" +
        '<h3 class="text-2xl md:text-4xl font-bold uppercase tracking-tighter leading-[0.9] mb-6">' +
        topic.title +
        "</h3>" +
        '<div class="flex flex-wrap items-center gap-4 text-muted-fg text-xs md:text-sm uppercase tracking-widest font-medium mb-6">' +
        "<span>by " +
        topic.author +
        "</span>" +
        "<span>↑ " +
        topic.votes +
        " votes</span>" +
        "<span>◦ " +
        topic.comments +
        " comments</span>" +
        "</div>" +
        '<a href="' +
        topic.url +
        '" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 h-10 px-6 bg-accent text-accent-fg font-bold uppercase tracking-tighter text-sm hover:scale-105 active:scale-95 transition-all">' +
        "Open Discussion →" +
        "</a>" +
        "</div>";
    }

    function getUnpickedTopics() {
      return topics.filter((topic) => topic.status === 'open' && !topicHistory.isTopicPicked(topic.id));
    }

    function displayAllPickedMessage() {
      selectedTopicDiv.innerHTML =
        '<div class="w-full text-center">' +
        '<h3 class="text-2xl md:text-4xl font-bold uppercase tracking-tighter text-accent mb-4">All topics picked!</h3>' +
        '<p class="text-muted-fg text-lg uppercase tracking-wider">Reset history to start over</p>' +
        "</div>";
    }

    function pickRandomTopic() {
      const unpickedTopics = getUnpickedTopics();

      if (unpickedTopics.length === 0) {
        displayAllPickedMessage();
        return;
      }

      const unpickedIds = new Set(unpickedTopics.map((t) => t.id));
      const cards = Array.from(document.querySelectorAll(".topic-card")).filter(
        (card) =>
          unpickedIds.has(parseInt(card.getAttribute("data-topic-id") || "0"))
      );

      let iterations = 0;
      const maxIterations = 20;
      const interval = setInterval(() => {
        cards.forEach((card) => {
          card.classList.remove("!bg-accent");
          const title = card.querySelector("h3");
          const meta = card.querySelector(
            ".flex.items-center.gap-4"
          ) as HTMLElement;
          if (title) {
            title.classList.remove("!text-accent-fg");
            title.classList.add("text-fg");
          }
          if (meta) {
            meta.classList.remove("!text-accent-fg/70");
          }
        });

        const randomIndex = Math.floor(Math.random() * cards.length);
        const randomCard = cards[randomIndex];
        randomCard.classList.add("!bg-accent");
        const title = randomCard.querySelector("h3");
        const meta = randomCard.querySelector(
          ".flex.items-center.gap-4"
        ) as HTMLElement;
        if (title) {
          title.classList.remove("text-fg");
          title.classList.add("!text-accent-fg");
        }
        if (meta) {
          meta.classList.add("!text-accent-fg/70");
        }

        iterations++;
        if (iterations >= maxIterations) {
          clearInterval(interval);
          const topicId = parseInt(
            randomCard.getAttribute("data-topic-id") || "0"
          );
          selectedTopicId = topicId;
          const topic = topics.find((t) => t.id === topicId);
          if (topic) {
            topicHistory.addPickedTopic(topicId);
            displaySelectedTopic(topic);
            randomCard.scrollIntoView({ behavior: "smooth", block: "center" });
            sortTopics(currentSort);
          }
        }
      }, 100);
    }

    const wheelColors = [
      "#DFE104",
      "#3F3F46",
      "#DFE104",
      "#3F3F46",
      "#DFE104",
      "#3F3F46",
      "#DFE104",
      "#3F3F46",
      "#DFE104",
      "#3F3F46",
    ];

    function drawWheel(topicsToDraw: Topic[] = topics, rotation = 0) {
      if (topicsToDraw.length === 0) return;

      const ctx = wheelCanvas.getContext("2d");
      if (!ctx) return;

      const centerX = wheelCanvas.width / 2;
      const centerY = wheelCanvas.height / 2;
      const radius = Math.min(centerX, centerY) - 10;
      const sliceAngle = (2 * Math.PI) / topicsToDraw.length;

      ctx.clearRect(0, 0, wheelCanvas.width, wheelCanvas.height);
      ctx.save();
      ctx.translate(centerX, centerY);
      ctx.rotate(rotation);

      topicsToDraw.forEach((topic, index) => {
        const startAngle = index * sliceAngle;
        const endAngle = startAngle + sliceAngle;

        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.arc(0, 0, radius, startAngle, endAngle);
        ctx.closePath();
        ctx.fillStyle = wheelColors[index % wheelColors.length];
        ctx.fill();
        ctx.strokeStyle = "#09090B";
        ctx.lineWidth = 2;
        ctx.stroke();

        ctx.save();
        ctx.rotate(startAngle + sliceAngle / 2);
        ctx.textAlign = "right";
        ctx.fillStyle =
          index % 2 === 0 ? "#000000" : "#FAFAFA";
        ctx.font = "bold 14px 'Space Grotesk', sans-serif";
        const text =
          topic.title.length > 30
            ? topic.title.substring(0, 27) + "..."
            : topic.title;
        ctx.fillText(text.toUpperCase(), radius - 10, 4);
        ctx.restore();
      });

      ctx.restore();

      // Center dot
      ctx.beginPath();
      ctx.arc(centerX, centerY, 20, 0, 2 * Math.PI);
      ctx.fillStyle = "#09090B";
      ctx.fill();
      ctx.strokeStyle = "#DFE104";
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    let isSpinning = false;

    function spinWheel() {
      const unpickedTopics = getUnpickedTopics();

      if (unpickedTopics.length === 0) {
        displayAllPickedMessage();
        wheelModal.classList.add("hidden");
        wheelModal.classList.remove("flex");
        return;
      }

      if (isSpinning || unpickedTopics.length === 0) return;
      isSpinning = true;
      wheelResult.classList.add("hidden");

      const spinDuration = 5000;
      const spinRevolutions = 5 + Math.random() * 5;
      const targetRotation = spinRevolutions * 2 * Math.PI;
      const startTime = Date.now();

      function animate() {
        const elapsed = Date.now() - startTime;
        const progress = Math.min(elapsed / spinDuration, 1);
        const easeOut = 1 - Math.pow(1 - progress, 3);
        const currentRotation = targetRotation * easeOut;

        drawWheel(unpickedTopics, currentRotation);

        if (progress < 1) {
          requestAnimationFrame(animate);
        } else {
          isSpinning = false;
          const sliceAngle = (2 * Math.PI) / unpickedTopics.length;
          const normalizedRotation = currentRotation % (2 * Math.PI);
          const selectedIndex =
            Math.floor((2 * Math.PI - normalizedRotation) / sliceAngle) %
            unpickedTopics.length;
          const selectedTopic = unpickedTopics[selectedIndex];

          const resultP = wheelResult.querySelector("p");
          if (resultP) resultP.textContent = selectedTopic.title;
          wheelResult.classList.remove("hidden");

          selectedTopicId = selectedTopic.id;
          topicHistory.addPickedTopic(selectedTopic.id);
          displaySelectedTopic(selectedTopic);

          setTimeout(() => {
            sortTopics(currentSort);
          }, 1000);
        }
      }

      animate();
    }

    function resetHistory() {
      if (
        confirm(
          "Are you sure you want to reset the pick history? This will allow all topics to be picked again."
        )
      ) {
        topicHistory.clearHistory();
        sortTopics(currentSort);
        selectedTopicDiv.innerHTML =
          '<p class="text-muted-fg text-lg md:text-xl uppercase tracking-wider font-medium">No topic selected yet</p>';
        updateResetButtonVisibility();
      }
    }

    function updateResetButtonVisibility() {
      const pickedCount = topicHistory.getPickedTopicIds().length;
      if (pickedCount > 0) {
        resetHistoryBtn.classList.remove("hidden");
      } else {
        resetHistoryBtn.classList.add("hidden");
      }
    }

    pickBtn.addEventListener("click", pickRandomTopic);

    spinBtn.addEventListener("click", () => {
      wheelModal.classList.remove("hidden");
      wheelModal.classList.add("flex");
      drawWheel(getUnpickedTopics());
    });

    closeModalBtn.addEventListener("click", () => {
      wheelModal.classList.add("hidden");
      wheelModal.classList.remove("flex");
    });

    wheelModal.addEventListener("click", (e) => {
      if (e.target === wheelModal) {
        wheelModal.classList.add("hidden");
        wheelModal.classList.remove("flex");
      }
    });

    spinWheelBtn.addEventListener("click", spinWheel);

    resetHistoryBtn.addEventListener("click", resetHistory);

    sortBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const sortBy = btn.getAttribute("data-sort") || "votes";
        currentSort = sortBy;

        sortBtns.forEach((b) => {
          b.classList.remove(
            "border-accent",
            "bg-accent",
            "text-accent-fg"
          );
          b.classList.add("border-border", "text-fg");
        });
        btn.classList.remove("border-border", "text-fg");
        btn.classList.add(
          "border-accent",
          "bg-accent",
          "text-accent-fg"
        );

        sortTopics(sortBy);
      });
    });

    topics = staticTopics;
    updateStats();
    sortTopics(currentSort);
    updateResetButtonVisibility();
    pickBtn.disabled = false;
    spinBtn.disabled = false;
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>

<style>
  .border-r-12 {
    border-right-width: 12px;
  }
</style>
